FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
{% import "openFOAM/utils.jinja"  as utils %}

application     {{values.application}};

startFrom       {{values.startFrom}};

startTime       {{values.startTime}};

stopAt          {{values.stopAt}};

endTime         {{values.endTime}};

deltaT          {{values.deltaT}};

writeControl    {{values.writeControl}};

writeInterval   {{values.writeInterval}};

purgeWrite      {{values.purgeWrite}};

writeFormat     {{values.writeFormat}};

writePrecision  {{values.writePrecision}};

writeCompression {%- if values.writeCompression %} yes {% else %} no {%- endif %};

timeFormat      {{values.timeFormat}};

timePrecision   {{values.timePrecision}};

runTimeModifiable {%- if values.runTimeModifiable %} yes {% else %} no {%- endif %};

adjustTimeStep  {%- if values.adjustTimeStep %} yes {% else %} no {%- endif %};

maxCo           {{values.maxCo}};

libs
(
    {%- for lib in values.libs -%}
       "{{lib}}"
    {%- endfor %}
);

functions
{
    {%- for functionName,functionData in values.functions.items() %}
        {{functionName}}
        {
            {% for attrName,attrData in functionData.items() %}
            {% if attrName == "libs" and attrData is iterable and (attrData is not string and attrData is not mapping) %}
            {{attrName}} (
                {%- for lib in attrData %} "{{ lib }}" {%- endfor -%}
            );
            {%else%}
            {% if attrData is boolean %}
            {{attrName}} {{utils.toBool(attrData)}};
            {% else %}
            {{attrName}} {{attrData}};
            {% endif %}
            {% endif %}
            {% endfor %}
        }
    {% endfor %}
}


