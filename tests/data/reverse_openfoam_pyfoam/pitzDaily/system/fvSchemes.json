{
  "fvSchemes": {
    "Execution": {
      "input_parameters": {
        "ddtSchemes": {
          "default": "steadyState"
        },
        "divSchemes": {
          "default": "none",
          "div((nuEff*dev2(T(grad(U)))))": [
            "Gauss",
            "linear"
          ],
          "div(nonlinearStress)": [
            "Gauss",
            "linear"
          ],
          "div(phi,U)": [
            "bounded",
            "Gauss",
            "linearUpwind",
            "grad(U)"
          ],
          "div(phi,epsilon)": [
            "bounded",
            "Gauss",
            "limitedLinear",
            1
          ],
          "div(phi,k)": [
            "bounded",
            "Gauss",
            "limitedLinear",
            1
          ],
          "div(phi,omega)": [
            "bounded",
            "Gauss",
            "limitedLinear",
            1
          ],
          "div(phi,v2)": [
            "bounded",
            "Gauss",
            "limitedLinear",
            1
          ]
        },
        "gradSchemes": {
          "default": [
            "Gauss",
            "linear"
          ]
        },
        "interpolationSchemes": {
          "default": "linear"
        },
        "laplacianSchemes": {
          "default": [
            "Gauss",
            "linear",
            "corrected"
          ]
        },
        "snGradSchemes": {
          "default": "corrected"
        },
        "wallDist": {
          "method": "meshWave"
        }
      }
    },
    "type": "openFOAM.system.FvSchemes",
    "version": 2
  }
}
